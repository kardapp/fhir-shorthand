        "min": 1,
        "max": "1"
      },
      {
        "id": "Procedure.identifier:laboratory-case-identifier.type",
        "path": "Procedure.identifier.type",
        "min": 1
      },
      {
        "id": "Procedure.identifier:laboratory-case-identifier.type.coding",
        "path": "Procedure.identifier.type.coding",
        "min": 1,
        "max": "1"
      },
