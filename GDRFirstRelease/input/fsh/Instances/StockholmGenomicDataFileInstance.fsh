Instance: StockholmGenomicDataFileExample
InstanceOf: StockholmGenomicDataFile
Usage: #example
Title: "Stockholm Genomic Data File example"
Description: "Example data file for genomic study outputs."

* status = #current
* content.attachment.url = "https://example.org/files/sample.fastq.gz"
* content.attachment.title = "sample.fastq.gz"
* content.attachment.contentType = #application/gzip
* content.attachment.creation = "2026-01-02"
